# Copy this file to .env.local and fill in the credentials on this PC.
# .env.local is ignored by Git; never commit your real keys.
# The local worker always uses OmniRoute. Gemini credentials belong in GitHub Secrets only.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key
# Legacy projects can use SUPABASE_SERVICE_KEY instead of SUPABASE_SECRET_KEY.
YOUTUBE_API_KEY=your-youtube-data-api-key

OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_API_KEY=your-omniroute-api-key
OMNIROUTE_MODELS=replace-with-a-model-id-from-v1-models

BATCH_SIZE=5
VIDEO_WORKER_POLL_SECONDS=60
VIDEO_WORKER_HEARTBEAT_SECONDS=30
VIDEO_WORKER_LEASE_SECONDS=180
LOCAL_DISCOVERY_INTERVAL_SECONDS=3600
# Local discovery checks recent uploads; GitHub's daily scan remains the full scan.
DISCOVERY_LIMIT=50
